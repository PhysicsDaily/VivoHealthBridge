<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark variant — the app's primary look. windowBackground kills the
      light flash at cold start before Compose takes over.
    -->
    <style name="Theme.VivoHealthBridge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:statusBarColor">@color/window_background_dark</item>
        <item name="android:navigationBarColor">@color/window_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>