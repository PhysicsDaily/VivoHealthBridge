    <string name="app_name">VivoHealthBridge</string>
    <string name="accessibility_service_description">Reads health data from Vivo Health app and syncs it to Health Connect. This service reads text displayed on screen when Vivo Health is open to extract your health metrics.</string>
    
    <!-- Permissions & Health Connect -->
    <string name="permissions_rationale_title">Health Connect Permissions</string>
    <string name="permissions_rationale_desc">VivoHealthBridge requires permissions to read and write your health metrics (steps, heart rate, sleep, blood oxygen, HRV, weight, exercise) to synchronize them seamlessly from Vivo Health into Google Health Connect.</string>
